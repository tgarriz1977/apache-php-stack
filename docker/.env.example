# Copiar a .env y editar:  cp .env.example .env
# (.env queda git-ignored; nunca commitear credenciales)

# Nombre del dominio que serviría el vhost (informativo en docker;
# el vhost acepta cualquier hostname: ServerAlias *).
DOMAIN=example.com

# PostgreSQL — mismos defaults que group_vars/all.yml
POSTGRES_DB=app
POSTGRES_USER=app
# PLACEHOLDER: cambiar antes de cualquier uso real.
POSTGRES_PASSWORD=changeme
